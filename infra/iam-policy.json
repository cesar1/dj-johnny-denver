{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteBookingsTable",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/chupon-bookings"
    },
    {
      "Sid": "SendBookingEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:REGION:ACCOUNT_ID:identity/djjohnnydenver.com"
    }
  ]
}
